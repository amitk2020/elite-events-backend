# Development environment file template
# Copy to .env.dev and update with your local database credentials

###> Symfony Development Environment ###
APP_ENV=dev
APP_DEBUG=1
###< Symfony Development Environment ###

###> Development Database ###
# Update with your local database credentials
DATABASE_URL="mysql://root:password@127.0.0.1:3306/elite_events?serverVersion=8.0&charset=utf8mb4"
###< Development Database ###

###> Development CORS ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< Development CORS ###
